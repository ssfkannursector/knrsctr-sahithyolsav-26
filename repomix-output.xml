  max-width: calc(100vw - 32px);
}

.download-btn {
  padding: 12px 36px;
  background: #c9a84c;
  color: #1a1100;
  border: none;
  border-radius: 999px;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: opacity .2s, transform .1s;
}
