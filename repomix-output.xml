  align-items: center;
  gap: 14px;
  padding: 14px 18px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}
.winner-quick-row:last-child { border-bottom: none; }

.winner-medal { font-size: 22px; flex-shrink: 0; }

.winner-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.winner-name {
  font-size: 16px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.2px;
}

.winner-unit {
  font-size: 11px;
  color: rgba(255,255,255,0.4);
  letter-spacing: 0.4px;
}

/* Poster section label */
.posters-section-label {
  font-size: 9px;
  letter-spacing: 4px;
  color: rgba(255,255,255,0.25);
  text-align: center;
  margin-bottom: 20px;
  text-transform: uppercase;
}

/* Posters grid */
.posters-grid {
  display: flex;
  flex-direction: column;
  gap: 32px;
  align-items: center;
}

.poster-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  width: 100%;
  max-width: 360px;
}

.poster-label {
  font-size: 9px;
  letter-spacing: 3px;
  color: rgba(255,255,255,0.3);
  text-transform: uppercase;
  text-align: center;
