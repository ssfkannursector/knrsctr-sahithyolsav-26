.admin-header { text-align: center; margin-bottom: 28px; position: relative; }
.admin-title  { font-size: 22px; font-weight: 900; color: #fff; }
.admin-sub    { font-size: 11px; color: #c9a84c; letter-spacing: 2px; margin-top: 4px; }

