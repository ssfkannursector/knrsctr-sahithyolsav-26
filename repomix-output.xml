.admin-winner-row { display: flex; flex-direction: column; gap: 8px; }

.admin-winner-label {
  font-size: 12px;
  font-weight: 700;
  color: rgba(255,255,255,0.55);
  letter-spacing: 0.5px;
}

.admin-winner-fields { display: flex; flex-direction: column; gap: 8px; }

.admin-error-msg   { font-size: 13px; color: #e74c3c; text-align: center; }
.admin-success-msg { font-size: 13px; color: #2ecc71; text-align: center; }

.admin-actions { display: flex; gap: 12px; }

.admin-save-btn {
  flex: 1;
  padding: 14px;
  background: #c9a84c;
  color: #1a1100;
  border: none;
  border-radius: 10px;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
  transition: opacity .2s;
}
.admin-save-btn:disabled { opacity: 0.6; cursor: not-allowed; }

.admin-clear-btn {
  padding: 14px 20px;
  background: transparent;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 10px;
  color: rgba(255,255,255,0.45);
  font-size: 14px;
  cursor: pointer;
  transition: border-color .2s;
}
.admin-clear-btn:hover { border-color: rgba(231,76,60,0.4); color: #e74c3c; }

.admin-overview       { margin-top: 10px; }
.admin-overview-title { font-size: 10px; letter-spacing: 3px; color: rgba(255,255,255,0.25); margin-bottom: 12px; text-transform: uppercase; }
.admin-overview-cat   { margin-bottom: 20px; }

.admin-overview-cat-name {
  font-size: 11px;
  color: #c9a84c;
  font-weight: 700;
  letter-spacing: 2px;
  margin-bottom: 6px;
  text-transform: uppercase;
}

.admin-overview-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 14px;
  border-radius: 8px;
  margin-bottom: 4px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  transition: border-color .2s;
}
.admin-overview-row.has-result { border-color: rgba(201,168,76,0.25); }

.admin-overview-prog   { font-size: 14px; color: rgba(255,255,255,0.65); }
.admin-overview-status { font-size: 11px; color: rgba(255,255,255,0.25); letter-spacing: 0.5px; }
.admin-overview-row.has-result .admin-overview-status { color: #c9a84c; }

