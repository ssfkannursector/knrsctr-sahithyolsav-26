  cursor: pointer;
  transition: border-color .2s, color .2s;
}
.admin-logout:hover { border-color: #e74c3c55; color: #e74c3c; }

.admin-form {
  max-width: 500px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.admin-row   { display: flex; flex-direction: column; gap: 14px; }
.admin-field { display: flex; flex-direction: column; gap: 6px; }

.admin-field label {
  font-size: 10px;
  letter-spacing: 3px;
  color: rgba(255,255,255,0.4);
