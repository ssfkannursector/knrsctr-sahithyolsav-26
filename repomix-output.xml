/* ═══════════════════════════════════════════════════════
   APP.CSS — Sahityotsav 2026
   ═══════════════════════════════════════════════════════ */

/* ─── HOME PAGE ──────────────────────────────────────── */

.home-container {
  background: #0d1920;
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* HEADER */
header {
  position: fixed;
  top: 0; left: 0;
  width: 100%;
  height: 75px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 12px;
  box-sizing: border-box;
  z-index: 1000;
  background: rgba(5, 10, 15, 0.55);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(255,255,255,.07);
}

.header-logo {
  height: 56px;
  width: auto;
  max-width: 68%;
  object-fit: contain;
  animation: logoReveal .8s ease-out forwards;
}

/* POSTER */
.poster-container {
  position: relative;
  margin-top: 75px;
  width: 100%;
  overflow: hidden;
  flex: 1;
}
.poster { width: 100%; display: block; }

.poster-container::after {
  content: "";
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 140px;
  background: linear-gradient(to bottom, transparent, #0d1920);
}

.results-btn {
  position: absolute;
  left: 50%;
  bottom: 28px;
  transform: translateX(-50%);
  z-index: 20;
  background: rgba(8, 18, 28, 0.75);
  backdrop-filter: blur(10px);
  color: #d4af37;
  border: 1px solid rgba(212,175,55,.4);
  border-radius: 999px;
  padding: 13px 28px;
  font-size: .95rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: background .25s, border-color .25s, transform .15s;
}
.results-btn:hover { background: rgba(212,175,55,0.12); border-color: rgba(212,175,55,.7); }
.results-btn:active { transform: translateX(-50%) scale(.97); }

/* ABOUT */
.about-section {
  display: flex;
  gap: 16px;
  padding: 30px 20px 48px;
  animation: fadeUp 1s ease-out;
}

.accent-line {
  width: 3px;
  min-height: 80px;
  flex-shrink: 0;
  border-radius: 999px;
  background: linear-gradient(to bottom, #d4af37, #f4d03f, transparent);
}

.about-text {
  margin: 0;
  color: rgba(255,255,255,0.75);
  text-align: left;
  line-height: 1.75;
  font-size: .98rem;
}

.highlight {
  color: #d4af37;
  font-weight: 700;
}

/* ─── FOOTER ─────────────────────────────────────────── */

.site-footer {
  background: #070f16;
  border-top: 1px solid rgba(255,255,255,0.06);
  padding: 40px 20px 28px;
  box-sizing: border-box;
  color: rgba(255,255,255,0.45);
  font-size: .85rem;
}

.footer-inner {
  max-width: 480px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  text-align: center;
}

.footer-logo-wrap img {
  height: 36px;
  opacity: 0.7;
}

.footer-tagline {
  font-size: .78rem;
  letter-spacing: 3px;
  color: rgba(212,175,55,0.5);
  text-transform: uppercase;
}

.footer-divider {
  width: 48px;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(212,175,55,0.4), transparent);
}

.footer-links {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
  justify-content: center;
}

.footer-links a {
  color: rgba(255,255,255,0.4);
  text-decoration: none;
  font-size: .8rem;
  letter-spacing: 1px;
  transition: color .2s;
}
.footer-links a:hover { color: #d4af37; }

.footer-copy {
  font-size: .72rem;
  color: rgba(255,255,255,0.2);
  letter-spacing: 0.5px;
}

.footer-copy span {
  color: rgba(212,175,55,0.4);
}

/* ─── RESULTS PAGE ───────────────────────────────────── */

.results-page {
  background: #0d1920;
  min-height: 100vh;
  padding: 0 0 80px;
  box-sizing: border-box;
}

/* Top nav bar */
.results-topnav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(7,15,22,0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,0.07);
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  box-sizing: border-box;
}

.results-back-btn {
  background: transparent;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 999px;
  color: rgba(255,255,255,0.6);
  font-size: 13px;
  padding: 6px 16px;
  cursor: pointer;
  transition: border-color .2s, color .2s;
  width: 80px;
  text-align: center;
}
.results-back-btn:hover { border-color: #d4af37; color: #d4af37; }

.results-nav-title {
  font-size: 13px;
  letter-spacing: 4px;
  color: rgba(255,255,255,0.5);
  text-transform: uppercase;
}

/* Selectors */
.selectors {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 24px 16px 0;
  max-width: 440px;
  margin: 0 auto;
}

.select-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.select-group label {
  font-size: 9px;
  letter-spacing: 4px;
  color: #c9a84c;
  font-weight: 700;
}

.select-wrapper {
  position: relative;
}

.select-wrapper select {
  width: 100%;
  padding: 13px 40px 13px 16px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 10px;
  color: #fff;
  font-size: 15px;
  font-family: inherit;
  appearance: none;
  -webkit-appearance: none;
  outline: none;
  cursor: pointer;
  transition: border-color .2s, background .2s;
  box-sizing: border-box;
}
.select-wrapper select:focus   { border-color: #c9a84c; background: rgba(201,168,76,0.05); }
.select-wrapper select:disabled { opacity: 0.35; cursor: not-allowed; }
.select-wrapper select option  { background: #0d1920; color: #fff; }

.select-arrow {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: rgba(201,168,76,0.6);
  font-size: 14px;
  pointer-events: none;
}

/* Empty states */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 70px 20px;
  color: rgba(255,255,255,0.25);
  font-size: 14px;
  letter-spacing: 0.5px;
}

.empty-icon { font-size: 36px; opacity: 0.5; }

.empty-spinner {
  width: 28px;
  height: 28px;
  border: 2px solid rgba(201,168,76,0.15);
  border-top-color: #c9a84c;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* Result heading */
.posters-section { padding: 28px 16px 0; }

.result-heading  { text-align: center; margin-bottom: 24px; }
.result-label    { font-size: 9px; letter-spacing: 4px; color: #c9a84c; margin-bottom: 6px; text-transform: uppercase; }
.result-title    { font-size: 28px; font-weight: 900; color: #fff; letter-spacing: -0.5px; line-height: 1.1; }
.result-category { font-size: 12px; color: rgba(255,255,255,0.4); margin-top: 4px; letter-spacing: 1px; }

/* Quick winners list */
.winners-quick-list {
  background: rgba(255,255,255,0.03);
